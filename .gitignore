# Secrets & state — never commit
vault/
profiles/
logs/
state/
# Browser profiles outside profiles/ — cookies/session tokens live here
scratch/browser-debug-profile/
scratch/report-6h-verify-profile/
scratch/report-6h-html-verify-profile/
gptaddon/playwright-user-data/
# Scratch and tmp working trees — snapshots and PoCs, never source of truth
scratch/
tmp/
*.local.json
.env
.env.*
KILLSWITCH
config/jobs.json
config/jobs.json.legacy-*
# Machine topology is a per-installation USER SETTING (owner directive
# 2026-08-10): this file holds one person's machine names, addresses, and
# checkout paths. config/machines.example.json is the shipped, address-free
# template; this is the live file and must never be committed.
config/machines.profile.json

# config/machines.json (retired): an older, untracked, zero-caller
# machine-to-root registry that duplicated the above and disagreed with
# config/service-registry.json about machine-a's root. Deleted along with its
# sole reader, src/lib/machine-registry.js; ignored here too so a future
# recreation can never land in a commit by accident.
config/machines.json

# Google account aliases are per-installation USER DATA, same convention as
# machines.profile.json above: this file holds one person's Google account
# aliases and emails. config/google-accounts.example.json is the shipped,
# placeholder-only template; this is the live file and must never be
# committed (see src/lib/google-accounts.js).
config/google-accounts.profile.json

# Paired computers are per-installation USER DATA, same convention as
# machines.profile.json above: this file names one person's other computers and
# holds the public keys and per-peer salts their link secrets are derived from.
# It contains no private key -- that stays in the DPAPI vault -- but it is still
# one person's topology and must never be committed (see
# src/lib/peer-enrollment.js). Absence of this file is a NORMAL, fully working
# single-computer install, so there is no shipped template to go with it.
config/peers.profile.json

# One customer's licence key, same convention as the two files above. It is a
# bearer credential for the relay we operate, so committing it would hand a
# paid entitlement to everyone with the repository. Absence of this file is a
# NORMAL, fully working, permanently supported install -- the Community tier --
# so there is no shipped template to go with it (see src/lib/entitlement.js,
# which is the single place that says so). The operator-side fulfilment ledger
# lives under state/, already ignored above.
config/entitlement.profile.json

# WHICH PADDLE ACCOUNT THIS INSTALLATION BILLS AGAINST -- sandbox or live. Same
# convention as the files above: it is one operator's decision about their own
# merchant account, not a product fact, and a committed copy would hand every
# checkout of this repository the environment of whoever committed it. Absence
# of this file is a NORMAL, fully working install and means SANDBOX; going live
# is the deliberate act of writing {"environment":"live"} here, which is why
# there is no shipped template that could be edited by accident (see
# src/lib/paddle-environment.js, the single place that says so).
config/paddle-environment.json

# Node
node_modules/

