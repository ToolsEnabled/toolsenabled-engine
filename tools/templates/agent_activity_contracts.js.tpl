function renderSafeContext(value) {
  validateSafeContext(value);
  const data = value.data;
  if (value.template === 'agent_state') return data.agentAlias + ' is ' + data.state + '.';
  if (value.template === 'delegation_state') return 'Delegation to ' + data.agentAlias + ' is ' + data.state + '.';
  if (value.template === 'phase_state') return data.phaseLabel + ' is ' + data.state + ' at ' + data.progressPercent + '%.';
  if (value.template === 'checkpoint_observed') return data.checkpointCount + ' checkpoint(s) observed.';
  if (value.template === 'help_state') return 'Help state is ' + data.state + '.';
  if (value.template === 'acceptance_state') return 'Acceptance is ' + data.acceptance + '.';
  if (value.template === 'report_state') return 'Report is ' + data.state + ' (' + data.freshness + ').';
  return data.evidenceCount + ' ' + data.evidenceKind + ' source(s) are ' + data.freshness + '.';
}

