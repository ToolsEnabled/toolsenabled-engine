  const requests = collect(value.requests, 'requestId', 'req', 'master-work-ledger.requests');
  const constraints = collect(value.constraints, 'constraintId', 'con', 'master-work-ledger.constraints');
  const decisions = collect(value.decisions, 'decisionId', 'dec', 'master-work-ledger.decisions');
  const gates = collect(value.gates, 'gateId', 'gate', 'master-work-ledger.gates');
  const phases = collect(value.phases, 'phaseId', 'phs', 'master-work-ledger.phases');
  validateOpaqueId(value.masterLink.missionId, 'ctx');
  validateOpaqueId(value.masterLink.requestId, 'req');
  validateOpaqueId(value.masterLink.phaseId, 'phs');
  if (value.masterLink.observedLedgerRevision > value.ledgerRevision) fail('master-work-ledger.masterLink', 'cannot observe a future ledger revision');
  assertReferences([value.masterLink.requestId], requests, 'master-work-ledger.masterLink.requestId');
  assertReferences([value.masterLink.phaseId], phases, 'master-work-ledger.masterLink.phaseId');
  assertReferences(value.masterLink.gateIds, gates, 'master-work-ledger.masterLink.gateIds');
  for (const item of value.goals) {
    assertReferences(item.requestIds, requests, 'master-work-ledger.goals.requestIds');
    assertReferences(item.constraintIds, constraints, 'master-work-ledger.goals.constraintIds');
    assertReferences(item.decisionIds, decisions, 'master-work-ledger.goals.decisionIds');
    assertReferences(item.gateIds, gates, 'master-work-ledger.goals.gateIds');
    assertReferences(item.phaseIds, phases, 'master-work-ledger.goals.phaseIds');
