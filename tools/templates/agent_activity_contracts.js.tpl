    validateOpaqueId(item.goalId, 'goal');
    assertReferences([item.goalId], goals, 'master-work-ledger.requests.goalId');
    assertReferences(item.gateIds, gates, 'master-work-ledger.requests.gateIds');
    assertReferences(item.plannedPhaseIds, phases, 'master-work-ledger.requests.plannedPhaseIds');
  }
  for (const item of value.constraints) {
    assertReferences(item.goalIds, goals, 'master-work-ledger.constraints.goalIds');
    assertReferences(item.phaseIds, phases, 'master-work-ledger.constraints.phaseIds');
