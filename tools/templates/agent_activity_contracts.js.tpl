function validateContract(name, value) {
  if (name === 'master-work-ledger') return validateMasterWorkLedger(value);
  const schema = SCHEMAS[name];
  if (!schema || name === 'common') fail('contract', 'is not a concrete contract');
  validateSchema(schema, value, name, schema);
  assertEnvelope(value, name);
  assertControlTimestamps(value);
  assertInternalId(name, value);
  if (name === 'edge') assertEdge(value);
  if (name === 'event') assertEvent(value);
  if (name === 'report-render-manifest') assertReportManifest(value);
  if (name === 'browser-event') {
    assertBrowserSafe(value);
    assertEventContext(value, 'browser-event');
  }
  if (name === 'snapshot') {
    assertBrowserSafe(value);
    for (const event of value.events) assertEventContext(event, 'snapshot.events');
  }
  if (name === 'history') {
    assertBrowserSafe(value);
    for (const event of value.detailEvents) assertEventContext(event, 'history.detailEvents');
  }
  return value;
}

