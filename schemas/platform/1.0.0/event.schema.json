{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:event:1.0.0",
  "title": "Coordinator platform event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "eventId": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]{8,128}$"},
    "taskId": {"type": "string", "pattern": "^tsk_[A-Za-z0-9_-]{8,128}$"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "kind": {"enum": ["submitted", "progress", "result", "accepted", "cancelled"]},
    "timestampMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "required": ["schemaVersion", "eventId", "taskId", "sequence", "kind", "timestampMs"]
}
