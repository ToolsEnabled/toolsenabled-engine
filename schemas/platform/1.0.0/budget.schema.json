{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:budget:1.0.0",
  "title": "Coordinator platform budget v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "budgetId": {"type": "string", "pattern": "^bud_[A-Za-z0-9_-]{8,128}$"},
    "scope": {"enum": ["task", "provider", "daily", "project"]},
    "limitMicros": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "spentMicros": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "required": ["schemaVersion", "budgetId", "scope", "limitMicros", "spentMicros"]
}
