{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:approval:1.0.0",
  "title": "Coordinator platform approval v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "approvalId": {"type": "string", "pattern": "^apr_[A-Za-z0-9_-]{8,128}$"},
    "taskId": {"type": "string", "pattern": "^tsk_[A-Za-z0-9_-]{8,128}$"},
    "action": {"type": "string", "minLength": 1, "maxLength": 160},
    "state": {"enum": ["pending", "approved", "denied", "expired"]},
    "expiresAtMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "required": ["schemaVersion", "approvalId", "taskId", "action", "state", "expiresAtMs"]
}
