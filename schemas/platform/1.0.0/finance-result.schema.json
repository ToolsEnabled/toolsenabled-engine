{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:finance-result:1.0.0",
  "title": "Coordinator platform read-only finance result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "asOfMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "source": {"type": "string", "minLength": 1, "maxLength": 160},
    "kind": {"enum": ["snapshot", "positions", "market-context"]},
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Deliberately extensible, source-labeled read-only finance payload; never carries credentials or order execution authority."
    }
  },
  "required": ["schemaVersion", "asOfMs", "source", "kind", "data"]
}
