{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:tool-package:1.0.0",
  "title": "Coordinator platform tool package v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "packageId": {"type": "string", "pattern": "^pkg_[A-Za-z0-9_-]{8,128}$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9_./-]{1,256}$"},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^cap_[A-Za-z0-9_.-]{3,128}$"}}
  },
  "required": ["schemaVersion", "packageId", "name", "version", "sha256", "entrypoint", "capabilities"]
}
