{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:resource-lease:1.0.0",
  "title": "Coordinator platform resource lease v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "leaseId": {"type": "string", "pattern": "^lease_[A-Za-z0-9_-]{8,128}$"},
    "resource": {"enum": ["model-runtime", "sandbox", "browser", "gpu", "cpu"]},
    "ownerTaskId": {"type": "string", "pattern": "^tsk_[A-Za-z0-9_-]{8,128}$"},
    "expiresAtMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "required": ["schemaVersion", "leaseId", "resource", "ownerTaskId", "expiresAtMs"]
}
