{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:provenance:1.0.0",
  "title": "Coordinator platform provenance envelope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "trusted-user",
          "trusted-configuration",
          "verified-local-state",
          "verified-project",
          "generated-model",
          "untrusted-repository",
          "untrusted-web",
          "untrusted-browser",
          "untrusted-download",
          "untrusted-agent",
          "secret",
          "secret-derived"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidenceId": {"type": "string", "pattern": "^ev_[A-Za-z0-9_-]{8,128}$"},
          "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "required": ["evidenceId", "contentHash"]
      }
    }
  },
  "required": ["schemaVersion", "labels", "sources"]
}
