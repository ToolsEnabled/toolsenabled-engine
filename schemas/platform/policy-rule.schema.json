{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:policy-rule:1.0.0",
  "title": "Coordinator deterministic policy rule v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "classification": { "enum": ["automatic", "confirmation-required", "user-performed", "blocked"] },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$" }
  },
  "required": ["schemaVersion", "id", "predicate", "classification", "reasonCode"]
}
