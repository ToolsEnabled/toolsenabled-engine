{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coordinator:platform:redaction-report:1.0.0",
  "title": "Coordinator platform redaction report v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "serviceId": {"const": "coordinator-platform-redaction-v1"},
    "egress": {"enum": ["provider", "log", "sse", "evidence-export", "notification", "training-candidate"]},
    "applied": {"const": true},
    "changed": {"type": "boolean"},
    "canaryDetected": {"type": "boolean"},
    "canaryCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "findingCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "detectorId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "category": {"enum": ["secret-handle", "account-identifier", "cookie", "token", "auth-code", "private-key", "payment", "credential", "canary", "user-sensitive"]},
          "count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        },
        "required": ["path", "detectorId", "category", "count"]
      }
    }
  },
  "required": ["schemaVersion", "serviceId", "egress", "applied", "changed", "canaryDetected", "canaryCount", "findingCount", "findings"]
}
