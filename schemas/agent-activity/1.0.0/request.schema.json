{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toolsenabled:agent-activity:request:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entityType", "requestId", "safeLabel", "state", "gateState", "observedAt", "contentTrust", "grantsAuthority", "safeDisplay"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "entityType": {"const": "request"},
    "requestId": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/p07OpaqueId"},
    "safeLabel": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/safeLabel"},
    "state": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/activityState"},
    "gateState": {"type": "string", "enum": ["not-started", "waiting", "satisfied", "rejected"]},
    "observedAt": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/controlTimestamp"},
    "contentTrust": {"const": "untrusted"},
    "grantsAuthority": {"const": false},
    "safeDisplay": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/safeDisplay"}
  }
}
