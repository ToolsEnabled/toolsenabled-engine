{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toolsenabled:agent-activity:history:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectionKind", "owner", "observedAt", "contentTrust", "grantsAuthority", "safeDisplay", "detailEvents", "aggregate"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "projectionKind": {"const": "browser-safe-history"},
    "owner": {"$ref": "#/$defs/browserOwner"},
    "observedAt": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/controlTimestamp"},
    "contentTrust": {"const": "untrusted"},
    "grantsAuthority": {"const": false},
    "safeDisplay": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/safeDisplay"},
    "detailEvents": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/browserDetailEvent"}},
    "aggregate": {"$ref": "#/$defs/aggregate"}
  },
  "$defs": {
    "browserOwner": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["agent", "goal", "request", "phase", "task", "evidence", "report"]},
        "alias": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/safeAlias"}
      }
    },
    "browserDetailEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["eventType", "sequence", "occurredAt", "context", "redactionState"],
      "properties": {
        "eventType": {"type": "string", "enum": ["agent_state", "delegation_state", "phase_state", "checkpoint_observed", "help_state", "acceptance_state", "report_state", "source_state"]},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "occurredAt": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/controlTimestamp"},
        "context": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/contextTemplate"},
        "redactionState": {"const": "redacted"}
      }
    },
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["windowStartedAt", "windowEndedAt", "windowEventCount", "wallTimeMs", "reportedTokenCount", "estimatedTokenCount", "toolBytes", "outputBytes", "retryCount", "noProgressCount", "errorSignatures", "acceptance", "workflowVersion"],
      "properties": {
        "windowStartedAt": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/controlTimestamp"},
        "windowEndedAt": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/controlTimestamp"},
        "windowEventCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "wallTimeMs": {"type": "integer", "minimum": 0, "maximum": 315576000000},
        "reportedTokenCount": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "estimatedTokenCount": {
          "type": "object", "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "label": {"const": "estimate-not-provider-reported"}
          }
        },
        "toolBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "outputBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "retryCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "noProgressCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "errorSignatures": {"type": "array", "maxItems": 64, "items": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/errorSignature"}, "uniqueItems": true},
        "acceptance": {"$ref": "urn:toolsenabled:agent-activity:common:1.0.0#/$defs/acceptance"},
        "workflowVersion": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,31}$"}
      }
    }
  }
}
