{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toolsenabled:agent-activity:common:1.0.0",
  "title": "Agent Activity v1 common definitions",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "p07OpaqueId": {
      "type": "string",
      "pattern": "^(agt|goal|req|phs|tsk|ev|rpt|evt|con|dec|gate|ctx)_[A-Za-z0-9_-]{32}$"
    },
    "controlTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "p07DomainHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "domain", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9:._-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provenanceLabel": {
      "type": "string",
      "enum": [
        "generated-model",
        "secret",
        "secret-derived",
        "trusted-configuration",
        "trusted-user",
        "untrusted-agent",
        "untrusted-browser",
        "untrusted-download",
        "untrusted-repository",
        "untrusted-web",
        "verified-local-state",
        "verified-project"
      ]
    },
    "safeDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "sourceCount", "containsSecret"],
      "properties": {
        "labels": {
          "type": "array",
          "items": {"$ref": "#/$defs/provenanceLabel"},
          "maxItems": 12,
          "uniqueItems": true
        },
        "sourceCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "containsSecret": {"type": "boolean"}
      }
    },
    "contentEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentTrust", "grantsAuthority", "safeDisplay"],
      "properties": {
        "contentTrust": {"const": "untrusted"},
        "grantsAuthority": {"const": false},
        "safeDisplay": {"$ref": "#/$defs/safeDisplay"}
      }
    },
    "safeAlias": {
      "type": "string",
      "enum": ["coordinator", "worker", "reviewer", "observer"]
    },
    "safeLabel": {
      "type": "string",
      "enum": ["discovery", "planning", "implementation", "validation", "review", "release", "maintenance", "blocked"]
    },
    "safeSummary": {
      "type": "string",
      "enum": [
        "Planned work is awaiting its next gate.",
        "Work is in progress.",
        "Work is awaiting a dependency.",
        "Work is ready for review.",
        "Work is complete.",
        "Work was not accepted.",
        "No projected work is available."
      ]
    },
    "activityState": {
      "type": "string",
      "enum": ["idle", "queued", "working", "blocked", "completed", "cancelled", "accepted", "rejected"]
    },
    "freshness": {
      "type": "string",
      "enum": ["fresh", "stale", "unverified", "missing", "invalid"]
    },
    "acceptance": {
      "type": "string",
      "enum": ["pending", "accepted", "rejected", "not-applicable"]
    },
    "errorSignature": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "contextTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "data"],
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "agent_state",
            "delegation_state",
            "phase_state",
            "checkpoint_observed",
            "help_state",
            "acceptance_state",
            "report_state",
            "source_state"
          ]
        },
        "data": {"type": "object"}
      },
      "oneOf": [
        {
          "properties": {
            "template": {"const": "agent_state"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["agentAlias", "state"],
              "properties": {
                "agentAlias": {"$ref": "#/$defs/safeAlias"},
                "state": {"$ref": "#/$defs/activityState"}
              }
            }
          }
        },
        {
          "properties": {
            "template": {"const": "delegation_state"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["agentAlias", "state"],
              "properties": {
                "agentAlias": {"$ref": "#/$defs/safeAlias"},
                "state": {"$ref": "#/$defs/activityState"}
              }
            }
          }
        },
        {
          "properties": {
            "template": {"const": "phase_state"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phaseLabel", "state", "progressPercent"],
              "properties": {
                "phaseLabel": {"$ref": "#/$defs/safeLabel"},
                "state": {"$ref": "#/$defs/activityState"},
                "progressPercent": {"type": "integer", "minimum": 0, "maximum": 100}
              }
            }
          }
        },
        {
          "properties": {
            "template": {"const": "checkpoint_observed"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checkpointCount"],
              "properties": {
                "checkpointCount": {"type": "integer", "minimum": 0, "maximum": 1000000}
              }
            }
          }
        },
        {
          "properties": {
            "template": {"const": "help_state"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state"],
              "properties": {"state": {"$ref": "#/$defs/activityState"}}
            }
          }
        },
        {
          "properties": {
            "template": {"const": "acceptance_state"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acceptance"],
              "properties": {"acceptance": {"$ref": "#/$defs/acceptance"}}
            }
          }
        },
        {
          "properties": {
            "template": {"const": "report_state"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "freshness"],
              "properties": {
                "state": {"$ref": "#/$defs/activityState"},
                "freshness": {"$ref": "#/$defs/freshness"}
              }
            }
          }
        },
        {
          "properties": {
            "template": {"const": "source_state"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidenceKind", "evidenceCount", "freshness"],
              "properties": {
                "evidenceKind": {"type": "string", "enum": ["file", "test", "tool", "report", "approval"]},
                "evidenceCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
                "freshness": {"$ref": "#/$defs/freshness"}
              }
            }
          }
        }
      ]
    }
  }
}
